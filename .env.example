# 复制成 .env.local 再填真 key（.env.local 不入库）
#
# 套餐端点（推荐，三件套都走这里，不额外计费）
DASHSCOPE_TOKENPLAN_KEY=sk-在这里贴你的百炼套餐 key
DASHSCOPE_TOKENPLAN_BASE=https://token-plan.cn-beijing.maas.aliyuncs.com
#
# 按量付费端点（可选：TTS 音色复刻/部分模型只有这里有）
DASHSCOPE_PAYG_KEY=
DASHSCOPE_PAYG_BASE=https://dashscope.aliyuncs.com
#
# 本地识别兜底：auto（默认，云端失败再用本地）/ on / off
ASR_LOCAL=auto