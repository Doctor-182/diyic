# ---- 运行时产物 ----
out/
dist/
*.log
*.log.1

# ---- 打包中间产物（PyInstaller 工作目录、冒烟用的临时用户目录）----
build/

# ---- 密钥（绝不入库）----
.env.local
.env
*.env.local

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pylibs/
_pylibs/
_pylibs_ct2_*/
_pylibs_cuda/
_probe/

# ---- 本地模型权重（>1 GB，单独分发）----
# GGUF（qwen17 / qwen06 / fun）由 tools/fetch_asr_models.py 下，不进仓库
models/**/*.onnx
models/**/*.bin
models/**/*.gguf
models/**/.cache/
models/anime-whisper-ct2-int8/
models/_dl/

# ---- 机器相关设置（设备序号/门限随机器不同）----
data/settings.json
data/*.bak

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
%SystemDrive%/

# ---- 音频/截图样本 ----
*.wav
out/
